rules_version = '2';
// Security rules for Ashen Vigil's realms. Paste into Firebase console > Firestore > Rules, or deploy with the Firebase CLI.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function shortText(v, n) { return v is string && v.size() <= n; }
    function num(v, lo, hi) { return (v is int || v is float) && v >= lo && v <= hi; }
    function isMember(gid) { return exists(/databases/$(db)/documents/guilds/$(gid)/members/$(request.auth.uid)); }

    match /realms/{rid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['n', 'name', 'players', 'opened', 'cap', 'mergedInto', 'closed'])
        && request.resource.data.players == 0 && request.resource.data.mergedInto == null
        && request.resource.data.opened == request.time && rid == 'r' + string(request.resource.data.n);
      // players may only add themselves; merging and closing are done by you in the Firebase console
      allow update: if signedIn() && changedOnly(['players']) && request.resource.data.players == resource.data.players + 1;

      match /scores/{uid} {
        allow read: if signedIn();
        allow delete: if isMe(uid);
        allow create, update: if isMe(uid)
          && request.resource.data.keys().hasOnly(['name', 'ava', 'plv', 'kills', 'guild', 'at', 's0', 's1', 's2', 's3', 'h0', 'h1', 'h2', 'h3'])
          && shortText(request.resource.data.name, 16) && shortText(request.resource.data.guild, 4) && shortText(request.resource.data.ava, 16)
          && num(request.resource.data.plv, 1, 500) && num(request.resource.data.kills, 0, 100000000)
          && num(request.resource.data.s0, 0, 1200) && num(request.resource.data.s1, 0, 1200) && num(request.resource.data.s2, 0, 1200) && num(request.resource.data.s3, 0, 1200)
          && num(request.resource.data.h0, 0, 1200) && num(request.resource.data.h1, 0, 1200) && num(request.resource.data.h2, 0, 1200) && num(request.resource.data.h3, 0, 1200);
      }

      match /boss/{week} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.keys().hasOnly(['hp', 'dmg', 'kind', 'created'])
          && request.resource.data.dmg == 0 && num(request.resource.data.hp, 1000000, 5000000000) && num(request.resource.data.kind, 0, 9);
        // each run may add at most 3 million damage
        allow update: if signedIn() && changedOnly(['dmg']) && request.resource.data.dmg > resource.data.dmg && request.resource.data.dmg - resource.data.dmg <= 3000000;
        match /hits/{uid} {
          allow read: if signedIn();
          allow delete: if isMe(uid);
          allow create: if isMe(uid) && request.resource.data.keys().hasOnly(['name', 'dmg', 'at']) && shortText(request.resource.data.name, 16) && num(request.resource.data.dmg, 0, 3000000);
          allow update: if isMe(uid) && request.resource.data.keys().hasOnly(['name', 'dmg', 'at']) && shortText(request.resource.data.name, 16)
            && request.resource.data.dmg >= resource.data.dmg && request.resource.data.dmg - resource.data.dmg <= 3000000;
        }
      }
    }

    match /players/{uid} {
      allow read: if signedIn();
      allow delete: if isMe(uid);
      allow create, update: if isMe(uid) && request.resource.data.keys().hasOnly(['realm', 'name', 'plv', 'guild', 'created']);
    }

    match /saves/{uid} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid) && request.resource.data.keys().hasOnly(['data', 'ts', 'plv', 'at']) && shortText(request.resource.data.data, 900000);
    }

    match /guilds/{gid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.leader == request.auth.uid && request.resource.data.members == 1 && request.resource.data.xp == 0
        && request.resource.data.keys().hasOnly(['realm', 'name', 'tag', 'leader', 'members', 'xp', 'open', 'desc', 'created'])
        && shortText(request.resource.data.name, 20) && request.resource.data.name.size() >= 3 && shortText(request.resource.data.tag, 4) && shortText(request.resource.data.desc, 120);
      allow update: if signedIn() && (
        (changedOnly(['members']) && request.resource.data.members <= 30
          && (request.resource.data.members == resource.data.members + 1 || request.resource.data.members == resource.data.members - 1))
        || (changedOnly(['xp']) && isMember(gid) && request.resource.data.xp > resource.data.xp && request.resource.data.xp - resource.data.xp <= 20)
        || (resource.data.leader == request.auth.uid && changedOnly(['desc', 'open', 'leader']) && shortText(request.resource.data.desc, 120))
      );
      allow delete: if signedIn() && resource.data.leader == request.auth.uid && resource.data.members <= 1;

      match /members/{uid} {
        allow read: if signedIn();
        allow create: if isMe(uid) && request.resource.data.keys().hasOnly(['name', 'role', 'xp', 'joined']) && request.resource.data.xp == 0
          && (request.resource.data.role == 'member' || get(/databases/$(db)/documents/guilds/$(gid)).data.leader == request.auth.uid
              || getAfter(/databases/$(db)/documents/guilds/$(gid)).data.leader == request.auth.uid);
        allow update: if isMe(uid) && changedOnly(['xp', 'name']) && request.resource.data.xp - resource.data.xp <= 20;
        allow delete: if isMe(uid) || get(/databases/$(db)/documents/guilds/$(gid)).data.leader == request.auth.uid;
      }

      match /chat/{mid} {
        allow read: if signedIn() && isMember(gid);
        allow create: if signedIn() && isMember(gid) && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at']) && shortText(request.resource.data.text, 160) && request.resource.data.text.size() > 0
          && shortText(request.resource.data.name, 16) && request.resource.data.at == request.time;
      }
    }

    // live-event calendar overrides: edit in the Firebase console, players can only read
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /reports/{rid} {
      allow create: if signedIn() && request.resource.data.by == request.auth.uid && shortText(request.resource.data.text, 200);
    }
  }
}
